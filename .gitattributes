# Normalize source files across Windows devices so autocrlf does not create
# false-positive working tree noise between threads.
*.py text eol=lf
*.ps1 text eol=crlf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.db binary
*.sqlite binary
*.sqlite3 binary
